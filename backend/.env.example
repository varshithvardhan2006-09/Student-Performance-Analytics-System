# ---------------------------------------------------------------------------
# SAPS backend -- environment template.  Copy to .env and fill in real values.
# This file contains NO secrets and IS committed to git.
# ---------------------------------------------------------------------------

# HTTP port the API server listens on.
PORT=3000

# MongoDB connection.  A local mongod is auto-started if none is reachable.
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB=student_analytics
MONGODB_USERS_COLLECTION=users
MONGODB_TIMEOUT_MS=5000

# REQUIRED. Minimum 32 characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace_with_64_plus_char_random_hex_string

# OPTIONAL. Groq API key for AI insights (https://console.groq.com/keys).
# Leave empty -- the app falls back to template-generated insights.
GROQ_API_KEY=

# Comma-separated browser origins allowed to call this API (CORS whitelist).
# e.g. https://yourusername.github.io
ALLOWED_ORIGINS=https://yourusername.github.io

# Single frontend origin (merged into ALLOWED_ORIGINS if set).
FRONTEND_URL=

# Max size of an incoming JSON / urlencoded request body.
JSON_LIMIT=2mb

# Demo teacher account auto-created at startup for showcasing the app.
DEMO_TEACHER_NAME=Demo Teacher
DEMO_TEACHER_EMAIL=demo.teacher@saps.local
DEMO_TEACHER_PASSWORD=Demo@1234
